# nanikiru 静态分发 nginx 站点配置（M4）。
# 2026-09-03（A 裁定）：独立子域 mahjonghelper.tangzheheshui.cn → /var/www/mahjonghelper。
# 同一台服务器上 tangzheheshui.cn 根已被用户其他项目占用（biliparser 反代 127.0.0.1:7900、
# wms 等）——本文件只服务本子域，不改任何其他站点。
# 缓存策略：manifest/config/index 不缓存（每次回源）；资源/分片 immutable（内容寻址）。
#
# 首次启用：
#   1) DNS A 记录 mahjonghelper → 服务器 IP（已由用户加）
#   2) 把本文件放 /etc/nginx/sites-available/mahjonghelper 并 ln -s 到 sites-enabled，
#      先以仅有 80 端口块（含 ACME）的配置启动
#   3) 签证书：certbot certonly --webroot -w /var/www/certbot -d mahjonghelper.tangzheheshui.cn
#   4) 取消下方 ssl_certificate 两行注释，nginx -t && reload

# --- 80：ACME 验证 + 跳 HTTPS ---
server {
  listen 80;
  listen [::]:80;
  server_name mahjonghelper.tangzheheshui.cn;

  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://mahjonghelper.tangzheheshui.cn$request_uri; }
}

# --- 443：本体 ---
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name mahjonghelper.tangzheheshui.cn;

  # HTTPS 证书（certbot 签发后取消注释）
  # ssl_certificate     /etc/letsencrypt/live/mahjonghelper.tangzheheshui.cn/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/mahjonghelper.tangzheheshui.cn/privkey.pem;

  root /var/www/mahjonghelper;

  # 兜底：SPA 路由 → index.html（manifest.webmanifest / sw 等真实文件优先命中）
  location / { try_files $uri $uri/ /index.html; }

  # --- 缓存策略 ---
  # Vite 构建产物带内容 hash：长缓存 immutable
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  # App 壳与 SW 不缓存：保证启动总能拿到新 index.html → 触发 SW 更新
  location = /index.html  { add_header Cache-Control "no-cache"; }
  location = /sw.js       { add_header Cache-Control "no-cache"; }
  location = /manifest.webmanifest { add_header Cache-Control "no-cache"; }

  # 题库：manifest 每次比对不缓存；分片按 v{bank_version} 内容寻址 → immutable
  location = /bank/manifest.json { add_header Cache-Control "no-cache"; }
  location /bank/               { add_header Cache-Control "public, max-age=31536000, immutable"; }

  # 远程配置：不缓存，改动即时生效（拉不到客户端用内置默认）
  location = /config.json  { add_header Cache-Control "no-cache"; }
  location = /version.json { add_header Cache-Control "no-cache"; }

  gzip on;
  gzip_types application/json text/css application/javascript image/svg+xml;
}
