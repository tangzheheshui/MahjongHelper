{
  "name": "nanikiru",
  "private": true,
  "version": "0.1.0",
  "description": "麻将「何切」训练教学 App——引擎、前端、题库内容 monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p packages/engine --noEmit",
    "bank:roll": "node content/build/roll-bank.mjs",
    "bank:publish": "node content/build/publish.mjs",
    "bank:dist": "node content/build/report-distribution.mjs",
    "bank:refine": "tsx content/build/refine.ts",
    "bank:verify": "tsx packages/engine/bin/verify.ts content/questions",
    "publish:test": "node content/build/test-publish.mjs",
    "e2e:bank": "tsx apps/web/scripts/e2e-bank.ts",
    "e2e:update": "tsx apps/web/scripts/e2e-update.ts",
    "e2e:smoke": "tsx apps/web/scripts/smoke-loop.ts",
    "selfcheck": "npm test && npm run typecheck -w @nanikiru/web && npm run bank:verify && npm run publish:test && npm run e2e:smoke && npm run e2e:update && npm run e2e:bank"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
